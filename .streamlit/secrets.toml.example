# Copy this file to .streamlit/secrets.toml and add your keys. Never commit the real file.

# Free Groq key for the LLM (parameter extraction + response phrasing).
# Get one at https://console.groq.com
GROQ_API_KEY = "gsk_your_key_here"

# Google Maps key used to geocode the user's free-text address into real coordinates
# in the 🤖 Agent tab. Reuse the same key as the Places scrape; enable the Geocoding API
# on it. Without this key the Agent falls back to city-only ranking (no distance).
GOOGLE_MAPS_API_KEY = "your_google_maps_key_here"
